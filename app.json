{
  "expo": {
    "name": "WasteWise",
    "slug": "wastewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app_icon.jpeg",
    "scheme": "wastewise",
    "deepLinks": true,
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.WasteWise",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "myapp",
              "host": "myapp.com",
              "pathPrefix": "/verify"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "52809b90-3f4a-4509-b1be-6341ddde5c5f"
      }
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "owner": "jeysi.zip"
  }
}
